  "saintTemplate1": "{name} 弟子，媽祖允你所問，此籤為【{signTitle}】。",
  "@saintTemplate1": {
    "placeholders": {
      "name": {"type": "String"},
      "signTitle": {"type": "String"}
    }
  },
  "saintTemplate2": "{name} 居士，慈航顯應，所示如籤。",
  "@saintTemplate2": {"placeholders": {"name": {"type": "String"}}},
  "saintTemplate3": "{name} 弟子，媽祖慈懷允示。籤曰【{signTitle}】，望善體天心。",
  "@saintTemplate3": {
    "placeholders": {
      "name": {"type": "String"},
      "signTitle": {"type": "String"}
    }
  },
  "saintTemplate4": "{name} 居士，慈帆已張，順風可期。籤中所示，請細參詳。",
  "@saintTemplate4": {"placeholders": {"name": {"type": "String"}}},
  "saintTemplate5": "{name} 居士，慈母允兒所請。籤曰【{signTitle}】，願你此去順遂。",
  "@saintTemplate5": {
    "placeholders": {
      "name": {"type": "String"},
      "signTitle": {"type": "String"}
    }
  },
  "saintTemplate6": "{name} 弟子，聖杯一擲已明。籤中所示，順勢而進可也。",
  "@saintTemplate6": {"placeholders": {"name": {"type": "String"}}},
  "saintTemplate7": "{name} 弟子，慈帆高掛，順風正起。籤曰【{signTitle}】，當進則進。",
  "@saintTemplate7": {
    "placeholders": {
      "name": {"type": "String"},
      "signTitle": {"type": "String"}
    }
  },
  "saintTemplate8": "{name} 弟子，媽祖含笑點頭，所示如籤。心定則事成。",
  "@saintTemplate8": {"placeholders": {"name": {"type": "String"}}},

  "laughTemplate1": "{name} 弟子，問事心要誠，媽祖未允。請閉目靜思片刻再請示。",
  "@laughTemplate1": {"placeholders": {"name": {"type": "String"}}},
  "laughTemplate2": "{name} 弟子，媽祖含笑不語。此問尚有未明之處，請細思後重新請示。",
  "@laughTemplate2": {"placeholders": {"name": {"type": "String"}}},
  "laughTemplate3": "{name} 弟子，媽祖含笑。此問或太急、或太泛，請緩一緩再問。",
  "@laughTemplate3": {"placeholders": {"name": {"type": "String"}}},
  "laughTemplate4": "{name} 居士，香火未透，媽祖示以笑杯。靜心三息，再來。",
  "@laughTemplate4": {"placeholders": {"name": {"type": "String"}}},
  "laughTemplate5": "{name} 弟子，問事如磨刀，太急則鈍。媽祖笑你急了些，請從容再來。",
  "@laughTemplate5": {"placeholders": {"name": {"type": "String"}}},
  "laughTemplate6": "{name} 弟子，媽祖搖頭笑曰：此問時機未到。請擇日再請示。",
  "@laughTemplate6": {"placeholders": {"name": {"type": "String"}}},
  "laughTemplate7": "{name} 弟子，媽祖笑而不答，必有緣由。靜心自省，答案或在心中。",
  "@laughTemplate7": {"placeholders": {"name": {"type": "String"}}},
  "laughTemplate8": "{name} 居士，媽祖笑杯示以未允。心未定時，再請示亦難應。",
  "@laughTemplate8": {"placeholders": {"name": {"type": "String"}}},

  "yinTemplate1": "{name} 弟子，媽祖示意此事不宜，宜緩行。",
  "@yinTemplate1": {"placeholders": {"name": {"type": "String"}}},
  "yinTemplate2": "{name} 弟子，此事有違天時。媽祖示意退一步，海闊天空。",
  "@yinTemplate2": {"placeholders": {"name": {"type": "String"}}},
  "yinTemplate3": "{name} 居士，心急則不達。媽祖示意緩行，待時來運轉。",
  "@yinTemplate3": {"placeholders": {"name": {"type": "String"}}},
  "yinTemplate4": "{name} 居士，媽祖明示此事不妥。強行為之，必有後患。",
  "@yinTemplate4": {"placeholders": {"name": {"type": "String"}}},
  "yinTemplate5": "{name} 弟子，媽祖不允，必有深意。切莫逆天行事，宜守不宜攻。",
  "@yinTemplate5": {"placeholders": {"name": {"type": "String"}}},
  "yinTemplate6": "{name} 弟子，媽祖垂憐，示以陰杯，是為你好。暫避鋒芒，謀定後動。",
  "@yinTemplate6": {"placeholders": {"name": {"type": "String"}}},
  "yinTemplate7": "{name} 居士，媽祖搖頭示警。眼前路不通，請耐心等候天時。",
  "@yinTemplate7": {"placeholders": {"name": {"type": "String"}}},
  "yinTemplate8": "{name} 弟子，陰杯示凶，非絕路。媽祖點你：轉個彎，路在前方。",
  "@yinTemplate8": {"placeholders": {"name": {"type": "String"}}},

