  "saintTemplate1": "{name} 弟子，妈祖允你所问，此签为【{signTitle}】。",
  "@saintTemplate1": {
    "placeholders": {
      "name": {"type": "String"},
      "signTitle": {"type": "String"}
    }
  },
  "saintTemplate2": "{name} 居士，慈航显应，所示如签。",
  "@saintTemplate2": {
    "placeholders": {
      "name": {"type": "String"}
    }
  },
  "saintTemplate3": "{name} 弟子，妈祖慈怀允示。签曰【{signTitle}】，望善体天心。",
  "@saintTemplate3": {
    "placeholders": {
      "name": {"type": "String"},
      "signTitle": {"type": "String"}
    }
  },
  "saintTemplate4": "{name} 居士，慈帆已张，顺风可期。签中所示，请细参详。",
  "@saintTemplate4": {
    "placeholders": {
      "name": {"type": "String"}
    }
  },
  "saintTemplate5": "{name} 居士，慈母允儿所请。签曰【{signTitle}】，愿你此去顺遂。",
  "@saintTemplate5": {
    "placeholders": {
      "name": {"type": "String"},
      "signTitle": {"type": "String"}
    }
  },
  "saintTemplate6": "{name} 弟子，圣杯一掷已明。签中所示，顺势而进可也。",
  "@saintTemplate6": {
    "placeholders": {
      "name": {"type": "String"}
    }
  },
  "saintTemplate7": "{name} 弟子，慈帆高挂，顺风正起。签曰【{signTitle}】，当进则进。",
  "@saintTemplate7": {
    "placeholders": {
      "name": {"type": "String"},
      "signTitle": {"type": "String"}
    }
  },
  "saintTemplate8": "{name} 弟子，妈祖含笑点头，所示如签。心定则事成。",
  "@saintTemplate8": {
    "placeholders": {
      "name": {"type": "String"}
    }
  },

  "laughTemplate1": "{name} 弟子，问事心要诚，妈祖未允。请闭目静思片刻再请示。",
  "@laughTemplate1": {"placeholders": {"name": {"type": "String"}}},
  "laughTemplate2": "{name} 弟子，妈祖含笑不语。此问尚有未明之处，请细思后重新请示。",
  "@laughTemplate2": {"placeholders": {"name": {"type": "String"}}},
  "laughTemplate3": "{name} 弟子，妈祖含笑。此问或太急、或太泛，请缓一缓再问。",
  "@laughTemplate3": {"placeholders": {"name": {"type": "String"}}},
  "laughTemplate4": "{name} 居士，香火未透，妈祖示以笑杯。静心三息，再来。",
  "@laughTemplate4": {"placeholders": {"name": {"type": "String"}}},
  "laughTemplate5": "{name} 弟子，问事如磨刀，太急则钝。妈祖笑你急了些，请从容再来。",
  "@laughTemplate5": {"placeholders": {"name": {"type": "String"}}},
  "laughTemplate6": "{name} 弟子，妈祖摇头笑曰：此问时机未到。请择日再请示。",
  "@laughTemplate6": {"placeholders": {"name": {"type": "String"}}},
  "laughTemplate7": "{name} 弟子，妈祖笑而不答，必有缘由。静心自省，答案或在心中。",
  "@laughTemplate7": {"placeholders": {"name": {"type": "String"}}},
  "laughTemplate8": "{name} 居士，妈祖笑杯示以未允。心未定时，再请示亦难应。",
  "@laughTemplate8": {"placeholders": {"name": {"type": "String"}}},

  "yinTemplate1": "{name} 弟子，妈祖示意此事不宜，宜缓行。",
  "@yinTemplate1": {"placeholders": {"name": {"type": "String"}}},
  "yinTemplate2": "{name} 弟子，此事有违天时。妈祖示意退一步，海阔天空。",
  "@yinTemplate2": {"placeholders": {"name": {"type": "String"}}},
  "yinTemplate3": "{name} 居士，心急则不达。妈祖示意缓行，待时来运转。",
  "@yinTemplate3": {"placeholders": {"name": {"type": "String"}}},
  "yinTemplate4": "{name} 居士，妈祖明示此事不妥。强为之，必有后患。",
  "@yinTemplate4": {"placeholders": {"name": {"type": "String"}}},
  "yinTemplate5": "{name} 弟子，妈祖不允，必有深意。切莫逆天行事，宜守不宜攻。",
  "@yinTemplate5": {"placeholders": {"name": {"type": "String"}}},
  "yinTemplate6": "{name} 弟子，妈祖垂怜，示以阴杯，是为你好。暂避锋芒，谋定后动。",
  "@yinTemplate6": {"placeholders": {"name": {"type": "String"}}},
  "yinTemplate7": "{name} 居士，妈祖摇头示警。眼前路不通，请耐心等候天时。",
  "@yinTemplate7": {"placeholders": {"name": {"type": "String"}}},
  "yinTemplate8": "{name} 弟子，阴杯示凶，非绝路。妈祖点你：转个弯，路在前方。",
  "@yinTemplate8": {"placeholders": {"name": {"type": "String"}}},

