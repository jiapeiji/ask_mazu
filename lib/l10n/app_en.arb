    "placeholders": {
      "name": {"type": "String"},
      "signTitle": {"type": "String"}
    }
  },
  "saintTemplate8": "Mazu smiles and nods. The sign is true. A steady heart wins all.",
  "@saintTemplate8": {"placeholders": {"name": {"type": "String"}}},

  "laughTemplate1": "A sincere heart, {name}. Mazu has not yet granted. Pause, reflect, then ask again.",
  "@laughTemplate1": {"placeholders": {"name": {"type": "String"}}},
  "laughTemplate2": "Mazu smiles but says nothing, {name}. Your question is unclear. Reflect and ask again.",
  "@laughTemplate2": {"placeholders": {"name": {"type": "String"}}},
  "laughTemplate3": "Mazu smiles, {name}. The question may be too hasty or too broad. Slow down and ask again.",
  "@laughTemplate3": {"placeholders": {"name": {"type": "String"}}},
  "laughTemplate4": "The incense is not yet ready, {name}. Take three quiet breaths and return.",
  "@laughTemplate4": {"placeholders": {"name": {"type": "String"}}},
  "laughTemplate5": "Asking Mazu is like sharpening a blade — too quickly dulls it. Mazu smiles at your haste. Slow down.",
  "@laughTemplate5": {"placeholders": {"name": {"type": "String"}}},
  "laughTemplate6": "Mazu shakes her head and smiles, {name}. The time is not yet right. Return another day.",
  "@laughTemplate6": {"placeholders": {"name": {"type": "String"}}},
  "laughTemplate7": "Mazu smiles without answering, {name}. There is a reason. Reflect inward — the answer may already be within you.",
  "@laughTemplate7": {"placeholders": {"name": {"type": "String"}}},
  "laughTemplate8": "The Laughing Cup is a \"not yet,\" {name}. An unsettled heart cannot receive an answer.",
  "@laughTemplate8": {"placeholders": {"name": {"type": "String"}}},

  "yinTemplate1": "Mazu signals this path is not right, {name}. Proceed slowly, if at all.",
  "@yinTemplate1": {"placeholders": {"name": {"type": "String"}}},
  "yinTemplate2": "This goes against the timing, {name}. Mazu says: step back — the sea is wide.",
  "@yinTemplate2": {"placeholders": {"name": {"type": "String"}}},
  "yinTemplate3": "Haste brings no gain, {name}. Mazu says: slow down, await the turning of fortune.",
  "@yinTemplate3": {"placeholders": {"name": {"type": "String"}}},
  "yinTemplate4": "Mazu clearly says this is wrong, {name}. To force it brings regret.",
  "@yinTemplate4": {"placeholders": {"name": {"type": "String"}}},
  "yinTemplate5": "Mazu does not grant, {name}. There is a deeper reason. Do not work against Heaven — defend, do not attack.",
  "@yinTemplate5": {"placeholders": {"name": {"type": "String"}}},
  "yinTemplate6": "Out of compassion, Mazu gives the Yin Cup, {name}. It is for your good. Sheath the blade; plan, then act.",
  "@yinTemplate6": {"placeholders": {"name": {"type": "String"}}},
  "yinTemplate7": "Mazu shakes her head in warning, {name}. The road ahead is closed. Wait patiently for Heaven's time.",
  "@yinTemplate7": {"placeholders": {"name": {"type": "String"}}},
  "yinTemplate8": "The Yin Cup warns of difficulty, not doom, {name}. Mazu points you: turn the corner — the road lies ahead.",
  "@yinTemplate8": {"placeholders": {"name": {"type": "String"}}},

